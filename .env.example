# Generate local credentials with pnpm setup:dev --allow-unscanned.
PSKILLS_ENVIRONMENT=development
PSKILLS_PUBLIC_ORIGIN=http://localhost:5173
PSKILLS_ORGANIZATION_ID=default
PSKILLS_BOOTSTRAP_ROLES=owner
PSKILLS_BOOTSTRAP_TOKEN=
PSKILLS_WORKER_TOKEN=
PSKILLS_SESSION_SECRET=
# Explicit development override. Keep false for production.
PSKILLS_ALLOW_UNSCANNED=false
PSKILLS_STATE_PROVIDER=file
PSKILLS_STATE_PATH=./work/data/state
PSKILLS_STORAGE_PROVIDER=filesystem
PSKILLS_STORAGE_ROOT=./work/data/blobs
PSKILLS_API_URL=http://localhost:5173
# Production: PSKILLS_ENVIRONMENT=production, state=postgres, storage=s3.
# DATABASE_URL=postgresql://...
# PSKILLS_STORAGE_BUCKET=
# PSKILLS_STORAGE_REGION=us-east-1
# PSKILLS_STORAGE_ENDPOINT=https://your-s3-compatible-endpoint
# PSKILLS_STORAGE_ACCESS_KEY_ID=
# PSKILLS_STORAGE_SECRET_ACCESS_KEY=
# PSKILLS_STORAGE_PATH_STYLE=true
# Files metadata in production requires one API process and PSKILLS_SINGLE_PROCESS=true.
# Edge: build with PSKILLS_RUNTIME_PROFILE=edge; configure HTTPS gateways below.
# PSKILLS_STATE_ENDPOINT=
# PSKILLS_STATE_TOKEN=
# PSKILLS_STORAGE_ENDPOINT=
# PSKILLS_STORAGE_TOKEN=
# Portable skills.sh directory gateway (non-Vercel Node or edge). Keep all
# three settings together; the URL must be an operator-controlled HTTPS base.
# PSKILLS_DIRECTORY_ENABLED=false
# PSKILLS_DIRECTORY_GATEWAY_URL=https://directory-gateway.example/skills
# PSKILLS_DIRECTORY_GATEWAY_TOKEN=
# Gateway host only: dedicated service token; never use a user's registry token.
# PSKILLS_GATEWAY_TOKEN=
# Scanner images are set to the digests emitted by scripts/scanner-acceptance.
# PSKILLS_IMAGE_CISCO=
# PSKILLS_IMAGE_NVIDIA=
# PSKILLS_IMAGE_SKILLSGUARD=
