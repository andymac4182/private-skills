# Generate local credentials with pnpm setup:dev --allow-unscanned.
PSKILLS_ENVIRONMENT=development
PSKILLS_PUBLIC_ORIGIN=http://localhost:5173
PSKILLS_ORGANIZATION_ID=default
PSKILLS_BOOTSTRAP_ROLES=owner
PSKILLS_BOOTSTRAP_TOKEN=
PSKILLS_WORKER_TOKEN=
PSKILLS_SESSION_SECRET=
# Better Auth identity is opt-in. When enabled, run the identity migration
# before serving requests; social sign-in never creates or adopts a tenant.
PSKILLS_BETTER_AUTH_ENABLED=false
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=
PSKILLS_BETTER_AUTH_BASE_PATH=/api/auth
PSKILLS_BETTER_AUTH_SCHEMA=
PSKILLS_BETTER_AUTH_VALIDATE_SCHEMA=true
PSKILLS_BETTER_AUTH_AUTO_MIGRATE=false
# Identity failure counters use a separate bounded table. Keep startup DDL
# disabled for multi-instance deployments and run the reviewed migration job.
PSKILLS_IDENTITY_OPERATIONS_EVENTS_AUTO_MIGRATE=false
PSKILLS_IDENTITY_OPERATIONS_EVENTS_TABLE_NAME=
PSKILLS_IDENTITY_OPERATIONS_EVENTS_RETENTION_DAYS=30
PSKILLS_IDENTITY_OPERATIONS_EVENTS_CLEANUP_BATCH_SIZE=1000
# The company SSO table shares PSKILLS_BETTER_AUTH_SCHEMA when configured.
# Keep this false for production unless one controlled process owns startup DDL.
PSKILLS_COMPANY_SSO_AUTO_MIGRATE=false
PSKILLS_COMPANY_SSO_TABLE_NAME=
# Persisted API-token DDL is included in IdentityInfrastructure.runMigrations().
# It stays in public by default for compatibility; set this to opt into a
# separate schema. Keep auto-migration false for production.
PSKILLS_API_TOKEN_SCHEMA=
PSKILLS_API_TOKEN_AUTO_MIGRATE=false
# Register only providers whose credentials are configured. Callback paths are
# /api/auth/callback/{provider-id}.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_AUTHORITY=https://login.microsoftonline.com
# JSON array of server-owned generic OIDC registrations; keep secrets out of
# browser configuration. Example shape is documented in docs/identity.md.
PSKILLS_OIDC_PROVIDERS_JSON=
PSKILLS_BETTER_AUTH_ORGANIZATION_LIMIT=10
PSKILLS_BETTER_AUTH_MEMBERSHIP_LIMIT=100
PSKILLS_BETTER_AUTH_INVITATION_LIMIT=100
PSKILLS_BETTER_AUTH_ALLOW_ORGANIZATION_CREATE=true
PSKILLS_BETTER_AUTH_EMAIL_DELIVERY=disabled
# Explicit development override. Keep false for production.
PSKILLS_ALLOW_UNSCANNED=false
PSKILLS_STATE_PROVIDER=file
PSKILLS_STATE_PATH=./work/data/state
PSKILLS_STORAGE_PROVIDER=filesystem
PSKILLS_STORAGE_ROOT=./work/data/blobs
PSKILLS_API_URL=http://localhost:5173
# Production: PSKILLS_ENVIRONMENT=production, state=postgres, storage=s3.
# DATABASE_URL=postgresql://...
# PSKILLS_STORAGE_BUCKET=
# PSKILLS_STORAGE_REGION=us-east-1
# PSKILLS_STORAGE_ENDPOINT=https://your-s3-compatible-endpoint
# PSKILLS_STORAGE_ACCESS_KEY_ID=
# PSKILLS_STORAGE_SECRET_ACCESS_KEY=
# PSKILLS_STORAGE_PATH_STYLE=true
# Files metadata in production requires one API process and PSKILLS_SINGLE_PROCESS=true.
# Edge: build with PSKILLS_RUNTIME_PROFILE=edge; configure HTTPS gateways below.
# PSKILLS_STATE_ENDPOINT=
# PSKILLS_STATE_TOKEN=
# PSKILLS_STORAGE_ENDPOINT=
# PSKILLS_STORAGE_TOKEN=
# Portable skills.sh directory gateway (non-Vercel Node or edge). Keep all
# three settings together; the URL must be an operator-controlled HTTPS base.
# PSKILLS_DIRECTORY_ENABLED=false
# PSKILLS_DIRECTORY_GATEWAY_URL=https://directory-gateway.example/skills
# PSKILLS_DIRECTORY_GATEWAY_TOKEN=
# Gateway host only: dedicated service token; never use a user's registry token.
# PSKILLS_GATEWAY_TOKEN=
# Scanner images are set to the digests emitted by scripts/scanner-acceptance.
# PSKILLS_IMAGE_CISCO=
# PSKILLS_IMAGE_NVIDIA=
# PSKILLS_IMAGE_SKILLSGUARD=
