{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private Skills pack draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "name", "version", "description", "skills"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "pack" },
    "name": { "$ref": "#/$defs/ref" },
    "version": { "type": "string", "minLength": 5, "maxLength": 128 },
    "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "version"],
        "properties": {
          "ref": { "$ref": "#/$defs/ref" },
          "version": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "maxLength": 131,
      "pattern": "^@[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
