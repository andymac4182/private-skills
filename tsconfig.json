{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "noEmit": true, "types": ["node", "vite/client"]
  },
  "include": ["packages/**/*.ts", "workers/**/*.ts", "apps/web/**/*.ts", "apps/web/**/*.tsx", "tests/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "**/.output", "**/routeTree.gen.ts"]
}
